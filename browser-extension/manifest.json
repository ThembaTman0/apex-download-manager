{
  "manifest_version": 3,
  "name": "Apex Download Manager",
  "version": "1.0.0",
  "description": "Send downloads to Apex Download Manager — multi-connection speed, pause/resume, scheduling.",
  "permissions": ["downloads", "downloads.ui", "cookies", "contextMenus", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apex Download Manager",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
