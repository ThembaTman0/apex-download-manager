{
  "manifest_version": 3,
  "name": "Apex Download Manager",
  "version": "1.0.0",
  "description": "Send downloads to Apex Download Manager — multi-connection speed, pause/resume, scheduling.",
  "permissions": ["downloads", "contextMenus", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apex Download Manager",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
